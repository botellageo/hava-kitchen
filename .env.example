# Firebase config — copier en .env.local et remplir
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emulator (dev local) — mettre "true" pour utiliser les emulateurs au lieu de Firebase prod
VITE_USE_EMULATOR=true

# Sentry (laisser vide en dev, remplir en prod)
VITE_SENTRY_DSN=
