rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isRestoOwner(rid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/restaurants/$(rid))
        && get(/databases/$(database)/documents/restaurants/$(rid)).data.ownerUid == request.auth.uid;
    }

    // Cuisinier authentifié via custom token CF avec claim restaurantId
    function isCuisinierOfResto(rid) {
      return isSignedIn() && request.auth.token.restaurantId == rid;
    }

    // ─────────────────────────────────────────────────────────
    // restaurants/{rid} — un restaurant par gérant
    // ─────────────────────────────────────────────────────────
    match /restaurants/{rid} {

      // Read : owner du resto OU cuisinier authentifié via custom claim restaurantId.
      allow read: if (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || isCuisinierOfResto(rid);

      // Create : authentifié + se déclare comme owner (anti-impersonation).
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['nom', 'ownerUid', 'managerPinHash', 'managerPinSalt', 'createdAt', 'updatedAt']);

      // Update : owner uniquement + ownerUid immutable (anti-takeover).
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      // Delete : interdit en it.1 (pas de cas d'usage).
      allow delete: if false;

      // ─────────────────────────────────────────────────────
      // sub: cuisiniers/{cid} — owner du resto CRUD complet
      // ─────────────────────────────────────────────────────
      match /cuisiniers/{cid} {
        allow read, create, update, delete: if isRestoOwner(rid);
      }

      // ─────────────────────────────────────────────────────
      // sub: pairingTokens/{tid} — tout passe par Cloud Function
      // (it.2 : QR pairing téléphone cuisinier)
      // ─────────────────────────────────────────────────────
      match /pairingTokens/{tid} {
        allow read, write: if false;
      }

      // ─────────────────────────────────────────────────────
      // sub: productTemplates/{pid} — templates DLC partagés
      // Read + create + update : owner ET cuisinier (le cuisinier peut
      // ajouter un nouveau produit ou ajuster la DLC à la volée depuis
      // l'écran Étiquettes en cuisine, sans repasser par l'admin).
      // Delete : owner only (préserve la cohérence avec l'historique
      // d'étiquettes qui référencent le nom du produit).
      // ─────────────────────────────────────────────────────
      match /productTemplates/{pid} {
        allow read, create, update: if isRestoOwner(rid) || isCuisinierOfResto(rid);
        allow delete: if isRestoOwner(rid);
      }

      // ─────────────────────────────────────────────────────
      // sub: equipements/{eid} — config frigos/sondes (mutable)
      // Read : owner + cuisinier (le futur module Températures liste
      // les équipements côté cuisine). Write : gérant uniquement.
      // ─────────────────────────────────────────────────────
      match /equipements/{eid} {
        allow read: if isRestoOwner(rid) || isCuisinierOfResto(rid);
        allow create, update, delete: if isRestoOwner(rid);
      }

      // ─────────────────────────────────────────────────────
      // sub: receptions/{recId} — HACCP immutable (preuve DDPP 3 ans)
      // Create par owner ou cuisinier authentifié. Champs obligatoires
      // garantissent l'intégrité de la preuve.
      // ─────────────────────────────────────────────────────
      match /receptions/{recId} {
        allow read: if isRestoOwner(rid) || isCuisinierOfResto(rid);
        allow create: if (isRestoOwner(rid) || isCuisinierOfResto(rid))
          && request.resource.data.keys().hasAll(['produit', 'photoUrl', 'createdAt', 'createdBy']);
        allow update, delete: if false;
      }

      // ─────────────────────────────────────────────────────
      // sub: etiquettes/{eid} — HACCP immutable (trace des étiquettes générées)
      // ─────────────────────────────────────────────────────
      match /etiquettes/{eid} {
        allow read: if isRestoOwner(rid) || isCuisinierOfResto(rid);
        allow create: if (isRestoOwner(rid) || isCuisinierOfResto(rid))
          && request.resource.data.keys().hasAll(['produit', 'prodDate', 'dlc', 'qte', 'createdAt', 'createdBy']);
        allow update, delete: if false;
      }

      // ─────────────────────────────────────────────────────
      // sub: exportsDdpp/{xid} — trace des registres générés
      // (gérant only, create-only : preuve qu'un export a eu lieu)
      // ─────────────────────────────────────────────────────
      match /exportsDdpp/{xid} {
        allow read: if isRestoOwner(rid);
        allow create: if isRestoOwner(rid)
          && request.resource.data.keys().hasAll(['mois', 'nbReceptions', 'nbEtiquettes', 'createdAt', 'createdBy']);
        allow update, delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────
    // Default deny — toute autre collection bloquée
    // ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
